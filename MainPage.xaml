<Page
    x:Class="NeteaseGameBarWidget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NeteaseGameBarWidget"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#1B1B1B"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF243447" Offset="0" />
                <GradientStop Color="#FF121212" Offset="0.55" />
                <GradientStop Color="#FF2A1E1A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="18">
            <local:WidgetView
                Width="520"
                Height="48"
                HorizontalAlignment="Center" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="#99FFFFFF"
                Text="Design preview · 在 Game Bar 中按 Win+G 添加此小组件" />
        </StackPanel>
    </Grid>
</Page>
