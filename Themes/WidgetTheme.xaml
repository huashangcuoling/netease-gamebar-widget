<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design system for the widget.

        Exactly one surface is painted in this app: the graphite acrylic card.
        Everything else is type, glyphs and two hairline accents. The system accent
        colour is allowed only on the progress fill, keyboard focus and the hovered
        glyph, so the album art stays the only large colour in the card.

        Keys are consumed with {ThemeResource} so the HighContrast dictionary below
        takes over automatically when Windows is in a contrast theme.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">

            <!-- Surface: one neutral graphite plate. -->
            <AcrylicBrush
                x:Key="CardSurfaceBrush"
                BackgroundSource="HostBackdrop"
                FallbackColor="#F0151518"
                TintColor="#FF191A1D"
                TintOpacity="0.55"
                TintLuminosityOpacity="0.32" />

            <SolidColorBrush x:Key="CardStrokeBrush" Color="#1FFFFFFF" />
            <Color x:Key="CardHighlightColor">#24FFFFFF</Color>

            <!-- Type. -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF3F3F5" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8FFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6EFFFFFF" />

            <!-- Glyphs. -->
            <SolidColorBrush x:Key="IconBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="IconHoverBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="IconDisabledBrush" Color="#4DFFFFFF" />

            <!-- Accent, used sparingly. -->
            <SolidColorBrush x:Key="FocusBrush" Color="{ThemeResource SystemAccentColorLight2}" />


            <!-- Album art frame and the empty-cover placeholder. -->
            <SolidColorBrush x:Key="ArtworkStrokeBrush" Color="#1AFFFFFF" />
            <LinearGradientBrush x:Key="PlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF3C424B" Offset="0" />
                <GradientStop Color="#FF23262B" Offset="1" />
            </LinearGradientBrush>

        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">

            <!-- No acrylic, no alpha, no gradients: system colours only. -->
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <Color x:Key="CardHighlightColor">Transparent</Color>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="IconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IconHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="IconDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="FocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />


            <SolidColorBrush x:Key="ArtworkStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Type scale. Three sizes only, so the card reads at a glance. -->

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!--
        Transport button: the surface is always transparent. Pointer-over only
        recolours the glyph; pressed adds a slight dim so the click has feedback
        even before the scale animation in code-behind kicks in.
    -->
    <Style x:Key="TransportButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource IconBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonRoot" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource IconHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource IconHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="0.72" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource IconDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="Glyph"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
