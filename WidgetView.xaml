<UserControl
    x:Class="NeteaseGameBarWidget.WidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NeteaseGameBarWidget"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.Name="网易云迷你播放器">

    <Grid>

        <!-- The single surface. Nothing else in the tree paints a background. -->
        <Border
            Background="{ThemeResource CardSurfaceBrush}"
            BorderBrush="{ThemeResource CardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="10" />

        <Border
            IsHitTestVisible="False"
            CornerRadius="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{ThemeResource CardHighlightColor}" />
                    <GradientStop Offset="0.5" Color="Transparent" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="Layout" Margin="10,7,10,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Cover, sized to the strip height. -->
            <Grid
                x:Name="CoverHost"
                Grid.Column="0"
                Width="36"
                Height="36"
                RenderTransformOrigin="0.5,0.5"
                VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="CoverTransform" />
                </Grid.RenderTransform>

                <Border
                    x:Name="ArtworkPlaceholder"
                    Background="{ThemeResource PlaceholderBrush}"
                    CornerRadius="8">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Glyph="&#xE8D6;"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <Border
                    x:Name="AlbumArtBorder"
                    CornerRadius="8"
                    Opacity="0"
                    Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <Border
                    BorderBrush="{ThemeResource ArtworkStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsHitTestVisible="False" />
            </Grid>

            <!-- Title, then artist/album, then the playhead. All fixed sizes. -->
            <StackPanel
                x:Name="TextColumn"
                Grid.Column="1"
                Margin="12,0,12,0"
                VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <CompositeTransform x:Name="TextTransform" />
                </StackPanel.RenderTransform>

                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource TitleTextStyle}"
                    Text="网易云音乐" />
                <TextBlock
                    x:Name="SubtitleText"
                    Margin="0,1,0,0"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="正在连接 SMTC…" />

            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <Button
                    x:Name="PreviousButton"
                    AutomationProperties.Name="上一首"
                    Click="PreviousButton_Click"
                    Content="&#xE892;"
                    IsEnabled="False"
                    PointerCanceled="TransportButton_PointerCanceled"
                    PointerCaptureLost="TransportButton_PointerCanceled"
                    PointerPressed="TransportButton_PointerPressed"
                    PointerReleased="TransportButton_PointerReleased"
                    Style="{StaticResource TransportButtonStyle}" />
                <Button
                    x:Name="PlayPauseButton"
                    Width="30"
                    Height="30"
                    AutomationProperties.Name="播放或暂停"
                    Click="PlayPauseButton_Click"
                    Content="&#xE768;"
                    FontSize="16"
                    IsEnabled="False"
                    PointerCanceled="TransportButton_PointerCanceled"
                    PointerCaptureLost="TransportButton_PointerCanceled"
                    PointerPressed="TransportButton_PointerPressed"
                    PointerReleased="TransportButton_PointerReleased"
                    Style="{StaticResource TransportButtonStyle}" />
                <Button
                    x:Name="NextButton"
                    AutomationProperties.Name="下一首"
                    Click="NextButton_Click"
                    Content="&#xE893;"
                    IsEnabled="False"
                    PointerCanceled="TransportButton_PointerCanceled"
                    PointerCaptureLost="TransportButton_PointerCanceled"
                    PointerPressed="TransportButton_PointerPressed"
                    PointerReleased="TransportButton_PointerReleased"
                    Style="{StaticResource TransportButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
