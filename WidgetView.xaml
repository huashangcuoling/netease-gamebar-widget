<UserControl
    x:Class="NeteaseGameBarWidget.WidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NeteaseGameBarWidget"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="377"
    Height="65"
    mc:Ignorable="d">

    <UserControl.Resources>
        <AcrylicBrush
            x:Key="CardAcrylicBrush"
            BackgroundSource="HostBackdrop"
            FallbackColor="#F0141414"
            TintColor="#141414"
            TintOpacity="0.52" />

        <!-- Keep the button surface transparent; only the glyph color changes. -->
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF8FD8FF" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66FFFFFF" />

        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <!-- The acrylic surface. Game Bar composites this over the desktop. -->
        <Border
            x:Name="Card"
            Background="{StaticResource CardAcrylicBrush}"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            CornerRadius="10" />

        <!-- Very subtle top highlight, so the card does not look flat. -->
        <Border
            CornerRadius="10"
            IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#18FFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="10,7,10,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Width="46"
                Height="46"
                VerticalAlignment="Center">
                <Border
                    x:Name="ArtworkPlaceholder"
                    CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3B6FA8" Offset="0" />
                            <GradientStop Color="#FF202936" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="19"
                        Foreground="#D9FFFFFF"
                        Glyph="&#xE8D6;" />
                </Border>

                <Border
                    x:Name="AlbumArtBorder"
                    CornerRadius="5"
                    Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush
                            x:Name="AlbumArtBrush"
                            Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel
                Grid.Column="2"
                Margin="0,0,6,0"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    FontFamily="Segoe UI"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFFFF"
                    MaxLines="1"
                    Text="网易云音乐"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="ArtistText"
                    Margin="0,2,0,0"
                    FontFamily="Segoe UI"
                    FontSize="11"
                    Foreground="#B3FFFFFF"
                    MaxLines="1"
                    Text="正在连接 SMTC…"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>

            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="PreviousButton"
                    AutomationProperties.Name="上一首"
                    Click="PreviousButton_Click"
                    Content="&#xE892;"
                    IsEnabled="False"
                    PointerEntered="TransportButton_PointerEntered"
                    PointerExited="TransportButton_PointerExited"
                    Style="{StaticResource TransportButtonStyle}" />
                <Button
                    x:Name="PlayPauseButton"
                    Width="34"
                    Height="34"
                    AutomationProperties.Name="播放或暂停"
                    Click="PlayPauseButton_Click"
                    Content="&#xE768;"
                    FontSize="16"
                    IsEnabled="False"
                    PointerEntered="TransportButton_PointerEntered"
                    PointerExited="TransportButton_PointerExited"
                    Style="{StaticResource TransportButtonStyle}" />
                <Button
                    x:Name="NextButton"
                    AutomationProperties.Name="下一首"
                    Click="NextButton_Click"
                    Content="&#xE893;"
                    IsEnabled="False"
                    PointerEntered="TransportButton_PointerEntered"
                    PointerExited="TransportButton_PointerExited"
                    Style="{StaticResource TransportButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="ProgressTrack"
            Height="2"
            Margin="12,0,12,6"
            VerticalAlignment="Bottom"
            Background="#26FFFFFF"
            CornerRadius="1"
            Visibility="Collapsed">
            <Rectangle
                x:Name="ProgressFill"
                Width="0"
                HorizontalAlignment="Left"
                Fill="#CCFFFFFF"
                RadiusX="1"
                RadiusY="1" />
        </Border>
    </Grid>
</UserControl>
